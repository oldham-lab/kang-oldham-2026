# Copy this file to .Renviron (gitignored) and edit the paths.
# R reads .Renviron at startup; config.R picks these up.

# Repo checkout:
REPO_DIR=/home/gugene/code/git/kang-oldham-2026

# Data roots (NOT distributed with the repo; see DATA.md):
DATA_DIR=/mnt/bdata/gugene
MEGASET_DIR=/home/gugene/RNAseq_megaset
DATA_OTHER_DIR=/home/gugene/data_other
EXTFIG_DIR=/home/gugene/figures

# Shared / external tool + data locations:
SHARED_DIR=/home/shared
ESSA_DIR=/home/gugene/code/git/ESSA
PSEUDOBULK_DIR=/home/gugene/code/git/Pseudobulk-from-SC-SN-data

# Large reference files not shipped in CoPA (MSigDB: download from gsea-msigdb.org;
# HGNC map: built by COPA/dataset_processing_unified/build_alias_map.R):
MSIGDB_XML=/home/gugene/code/git/COPA/data/msigdb_v7.4.xml
HGNC_MAP=/home/gugene/code/git/COPA/dataset_processing_unified/hgnc_prev_to_current.tsv

# Cell-type AD-vs-control DE results for fig_7 (~140MB, NOT tracked; regenerate
# via figures/fig_7/v4/full_DE_pipeline_ADvsCon.R + DE/concat_DE_results.R).
# Default is a gitignored in-repo dir; override to reuse existing objects:
DE_DIR=/home/gugene/code/git/kang-oldham-2026/figures/fig_7/DE_old
